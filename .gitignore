# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# PyInstaller 构建产物
build/
dist/
*.spec.bak

# 构建时生成的 PE 版本元数据（唯一来源是 src/core.py 的 LAUNCHER_VERSION，
# 由 tools/bump_version.py 生成；不入库以免出现"元数据停留在旧版本"的问题）
version_info.txt
version_info_backend.txt

# CI 生成的 Release 说明
release_body.md

# 下载残留（aria2 分片/控制文件）
*.aria2

# 内嵌安装包（二进制大文件，不入库；由更新机制下载）
installer/*.exe

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 日志
*.log

# 测试缓存
.pytest_cache/
.mypy_cache/

# 构建时注入的密钥（不入库）
src/_secrets.py
